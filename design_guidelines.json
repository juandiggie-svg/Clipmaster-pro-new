{
  "project_name": "ClipMaster Pro",
  "platform": "React Native (Expo)",
  "theme_archetype": "Archetype 5 (Jewel & Luxury) + Archetype 2 (Performance Pro)",
  "design_philosophy": "Dark + Gold 'barbershop-cool'. Premium, high-contrast, masculine but inclusive, built for speed and utility. Relies on deep blacks, sharp gold accents, and stark typography. No cluttered tab bars; use a Hub/Dashboard bento grid for tool discovery.",
  "color_palette": {
    "background": "#050505",
    "surface": "#121212",
    "surface_border": "#262626",
    "primary": "#FFD700",
    "primary_dark": "#CCAC00",
    "text_primary": "#FFFFFF",
    "text_secondary": "#A3A3A3",
    "success": "#10B981",
    "error": "#EF4444",
    "platform_instagram": "#E1306C",
    "platform_tiktok": "#00F2FE",
    "overlay": "rgba(0, 0, 0, 0.7)"
  },
  "typography": {
    "fonts": {
      "heading": "Bebas Neue",
      "body": "DM Sans"
    },
    "scale": {
      "h1": {
        "fontSize": 48,
        "fontFamily": "Bebas Neue",
        "letterSpacing": 1,
        "lineHeight": 52
      },
      "h2": {
        "fontSize": 36,
        "fontFamily": "Bebas Neue",
        "letterSpacing": 0.5,
        "lineHeight": 40
      },
      "h3": {
        "fontSize": 24,
        "fontFamily": "Bebas Neue",
        "letterSpacing": 0.5,
        "lineHeight": 28
      },
      "body_large": {
        "fontSize": 18,
        "fontFamily": "DM Sans",
        "fontWeight": "500",
        "lineHeight": 26
      },
      "body": {
        "fontSize": 16,
        "fontFamily": "DM Sans",
        "fontWeight": "400",
        "lineHeight": 24
      },
      "body_small": {
        "fontSize": 14,
        "fontFamily": "DM Sans",
        "fontWeight": "400",
        "lineHeight": 20
      },
      "label": {
        "fontSize": 12,
        "fontFamily": "DM Sans",
        "fontWeight": "700",
        "textTransform": "uppercase",
        "letterSpacing": 1.5
      }
    }
  },
  "spacing_and_layout": {
    "screen_padding": 16,
    "bento_grid_gap": 12,
    "border_radius": {
      "small": 8,
      "medium": 12,
      "large": 16,
      "pill": 9999
    }
  },
  "component_specs": {
    "PrimaryButton": {
      "backgroundColor": "#FFD700",
      "textColor": "#050505",
      "height": 56,
      "borderRadius": 12,
      "fontFamily": "DM Sans",
      "fontWeight": "700",
      "fontSize": 18,
      "justifyContent": "center",
      "alignItems": "center"
    },
    "SecondaryButton": {
      "backgroundColor": "transparent",
      "borderColor": "#262626",
      "borderWidth": 1,
      "textColor": "#FFFFFF",
      "height": 56,
      "borderRadius": 12,
      "fontFamily": "DM Sans",
      "fontWeight": "600",
      "fontSize": 16
    },
    "FeatureTile": {
      "backgroundColor": "#121212",
      "borderColor": "#262626",
      "borderWidth": 1,
      "borderRadius": 16,
      "padding": 16,
      "aspectRatio": 1,
      "flex": 1,
      "activeState": {
        "borderColor": "#FFD700"
      }
    },
    "ContentCard": {
      "backgroundColor": "#121212",
      "borderRadius": 16,
      "padding": 20,
      "borderColor": "#262626",
      "borderWidth": 1
    },
    "Chip": {
      "paddingVertical": 8,
      "paddingHorizontal": 16,
      "borderRadius": 9999,
      "inactive": {
        "backgroundColor": "#121212",
        "textColor": "#FFFFFF",
        "borderColor": "#262626",
        "borderWidth": 1
      },
      "active": {
        "backgroundColor": "#FFD700",
        "textColor": "#050505",
        "borderColor": "#FFD700",
        "borderWidth": 1
      }
    },
    "Input": {
      "backgroundColor": "#0A0A0A",
      "borderColor": "#262626",
      "borderWidth": 1,
      "borderRadius": 12,
      "padding": 16,
      "color": "#FFFFFF",
      "focusState": {
        "borderColor": "#FFD700"
      }
    }
  },
  "screen_blueprints": {
    "PaywallScreen": {
      "layout": "FullScreen",
      "background": "Image overlay with gradient to deep black (#050505)",
      "elements": [
        "Hero Text: 'CLIPMASTER PRO' (Bebas Neue, 48px, Gold)",
        "Subtitle: 'Automate your barbershop social media.'",
        "Features List (Checkmarks + Text)",
        "PrimaryButton: 'Start 3-Day Free Trial ($4.99/mo)'",
        "Link: 'Restore Purchases'"
      ]
    },
    "OnboardingFlow": {
      "layout": "Step-by-step with Gold Progress Bar at top",
      "steps": [
        "Step 1: Name & Business Name (Text Inputs)",
        "Step 2: Niche Selection (Wrap Flex layout with Chips - e.g., Barber, Braider, Colorist)",
        "Step 3: City & Booking Link (Text Inputs) + 'Complete Setup' Button"
      ]
    },
    "DashboardHub": {
      "layout": "ScrollView with Bottom Tab Navigator",
      "header": "User greeting (Left), Trial Counter Badge (Right - Gold bg, Black text)",
      "content": "2-column grid (FlatList numColumns=2) of 11 Feature Tiles. Icons top-aligned, title bottom-aligned in tile. Use Lucide icons."
    },
    "Tool_ContentGenerator": {
      "layout": "Form to Result",
      "input_section": "Text Input / Dropdowns for tone",
      "result_section": "ContentCard with generated text. Bottom row contains 'Copy' button. Top right has platform indicator dot/color."
    },
    "Tool_BeforeAfter": {
      "layout": "Dual image picker using expo-image-picker",
      "elements": [
        "Upload Box 1 (Before)",
        "Upload Box 2 (After)",
        "PrimaryButton: 'Generate Post'"
      ]
    }
  },
  "instructions_to_main_agent": [
    "Use standard React Native StyleSheet or NativeWind for styling. If NativeWind, map hex colors to config.",
    "Implement Bebas Neue and DM Sans using expo-font. Use 'BebasNeue-Regular' for headings.",
    "Navigation: Use @react-navigation/native. The app needs a Stack (Paywall -> Onboarding -> MainTabs).",
    "MainTabs should be a BottomTabNavigator. Include Home(Hub), Calendar, Tracker. The 11 tools should be accessible via the Home Hub grid, not all as separate tabs.",
    "For the Hub grid, use standard React Native `View` with `flexDirection: 'row', flexWrap: 'wrap'` and `gap` to create the bento grid, or `FlatList` with `numColumns={2}`.",
    "Ensure the 'data-testid' attributes are attached to all Touchables and Inputs for testing."
  ],
